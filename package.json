{
  "name": "@portone/mcp-server",
  "version": "0.20.0",
  "description": "포트원 사용자를 위한 MCP (Model Context Protocol) 서버입니다. 포트원 개발자센터, 헬프센터 등 공식 문서 내용을 LLM(Large Language Model)에 제공해 정확한 정보를 바탕으로 사용자의 연동 및 질의를 돕도록 합니다.",
  "main": "server/index.js",
  "type": "module",
  "bin": {
    "portone-mcp-server": "./server/index.js"
  },
  "scripts": {
    "test": "vitest",
    "update-docs": "node update-docs.ts",
    "build": "tsup src/index.ts --outDir server --format esm",
    "build:dxt": "node scripts/build-dxt.ts",
    "dev": "node src/index.ts",
    "start": "node server/index.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "changeset:version": "changeset version && node scripts/sync-manifest-version.js && biome format --write manifest.json"
  },
  "keywords": [
    "mcp",
    "portone",
    "model-context-protocol"
  ],
  "author": {
    "name": "PortOne",
    "email": "tech.support@portone.io"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@portone/server-sdk": "^0.17.0",
    "axios": "^1.13.6",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "gray-matter": "^4.0.3",
    "h3": "2.0.1-rc.2",
    "js-yaml": "^4.1.1",
    "open": "^10.2.0",
    "ts-pattern": "^5.9.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@changesets/cli": "^2.31.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.1",
    "type-fest": "^5.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "server",
    "assets",
    "manifest.json",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "repository": "github:portone-io/mcp-server"
}
